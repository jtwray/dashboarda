import { getStore,getDeployStore } from "@netlify/blobs";import type { Context,Config } from "@netlify/functions";function store(){return Netlify.context?.deploy?.context==="production"?getStore("home-board",{consistency:"strong"}):getDeployStore("home-board")}export default async(req:Request,_c:Context)=>{const p=Netlify.env.get("HOME_BOARD_PIN");if(!p||req.headers.get("x-board-pin")!==p)return new Response("Unauthorized",{status:401});const s=store();if(req.method==="GET")return Response.json((await s.get("state",{type:"json"}))??{items:[]});if(req.method==="POST"){const b:any=await req.json(),n={items:Array.isArray(b.items)?b.items:[],updatedAt:new Date().toISOString()};await s.setJSON("state",n);return Response.json(n)}return new Response("Method not allowed",{status:405})};export const config:Config={path:"/api/state"};