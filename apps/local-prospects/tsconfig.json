{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@netlify/functions"
    ]
  },
  "include": [
    "signaldesk/**/*.ts",
    "test/**/*.ts",
    "netlify/functions/signaldesk*.mts"
  ]
}
